# Copy to the skill directory as .env.local; setup creates it only when absent.
# Values are literal text: no shell expansion, no inline comments.
# CLI options override environment variables, which override this file.

# API connection.
LAYA_API_BASE=
LAYA_API_MODEL=laya-decision
LAYA_API_KEY=

# Optional login credentials.
TEST_USER=
TEST_PASSWORD=

# Reusable login: set both the state file and a unique authenticated-page selector.
TEST_AUTH_STATE=
TEST_AUTH_CHECK=

# Pass the workbook, URL and other task options on each run.
# Advanced options: references/setup.md
