{
    "name": "laya-pilot",
    "version": "0.2.2",
    "private": false,
    "description": "Run browser regression tests from existing Excel cases for enterprise admin applications",
    "license": "MIT",
    "engines": {
        "node": ">=20"
    },
    "type": "module",
    "bin": {
        "laya": "bin/laya.mjs"
    },
    "files": [
        "bin/laya.mjs",
        "scripts/postinstall.mjs",
        "scripts/common.mjs",
        "scripts/run.mjs",
        "scripts/runner.mjs",
        "scripts/setup.mjs",
        "scripts/worker.py",
        "scripts/lib/*.mjs",
        "scripts/lib/*.py",
        "requirements.txt",
        "requirements-local.txt",
        "assets/.env.example",
        "assets/test-cases-template.xlsx"
    ],
    "scripts": {
        "format": "npm run format:web && npm run format:python",
        "format:check": "npm run format:web:check && npm run format:python:check",
        "format:web": "prettier --write .",
        "format:web:check": "prettier --check .",
        "format:python": "uv tool run --from ruff==0.15.21 ruff format .",
        "format:python:check": "uv tool run --from ruff==0.15.21 ruff format --check .",
        "test": "node --test --test-concurrency=1 tests/*.test.mjs",
        "test:browser": "node --test tests/browser/*.test.mjs",
        "test:model": "node --test tests/real-model.smoke.mjs",
        "skill:package": "uv run --no-project python scripts/package_skill.py",
        "skill:check": "uv run --no-project python scripts/package_skill.py --check",
        "start": "node scripts/run.mjs",
        "demo": "node scripts/demo-server.mjs",
        "postinstall": "node scripts/postinstall.mjs"
    },
    "dependencies": {
        "acorn": "8.15.0",
        "playwright": "1.62.1"
    },
    "devDependencies": {
        "prettier": "3.9.9"
    }
}
