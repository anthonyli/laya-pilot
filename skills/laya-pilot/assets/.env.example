# Copy to the skill directory as .env.local; setup.mjs does this if absent.
# Fill these with your own HTTPS Chat Completions gateway and model name.
# Example base URL: https://your-gateway.example/v1
LAYA_API_BASE=
LAYA_API_MODEL=laya-decision
LAYA_API_KEY=

# Optional test login; passwords and keys stay out of JSON and command lines.
TEST_USER=
TEST_PASSWORD=
